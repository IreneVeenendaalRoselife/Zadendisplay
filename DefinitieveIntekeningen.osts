// Office Script: definitieve intekeningen uit het Forms-antwoordenblad.
// Per winkel (gekoppeld via Winkelnummer of SAP Winkelnr) telt het laatste antwoord (hoogste Id).
// Alleen winkels waarvan het laatste antwoord "Intekenen" is, komen in de tabel.
// De tabel begint op rij 2. In rij 1 komt boven de aantal-kolommen het totaal
// (SUBTOTAAL, dus bij filteren telt het alleen de zichtbare regels).
function main(workbook: ExcelScript.Workbook): string {
  const SOURCE_TABLE = "OfficeForms.Table";
  const TARGET_SHEET = "Definitieve Intekeningen";
  const TARGET_TABLE = "DefinitieveIntekeningen";
  const START_ROW = 1; // 0 = rij 1, 1 = rij 2
  const GROEP_KOLOMMEN: string = "B:E"; // deze kolommen worden gegroepeerd en dichtgeklapt ("" = niet)
  // Kolommen waarvan bovenaan het totaal komt. Exacte kolomnaam, of een deel
  // ervan (bijvoorbeeld als de vraag in Forms langer is).
  const TOTAAL_KOLOMMEN = [
    "Zadendisplay",
    "Bloemenweide",
    "Aardbeien Hangtuin",
    "Tomaten Keukentuin"
  ];

  const source = workbook.getTable(SOURCE_TABLE);
  const headers = source.getHeaderRowRange().getTexts()[0];
  const rows = source.getRangeBetweenHeaderAndTotal().getValues();

  const col = (name: string): number => {
    const index = headers.indexOf(name);
    if (index < 0) {
      throw new Error("Kolom niet gevonden: " + name);
    }
    return index;
  };

  // Kolom zoeken op exacte naam, anders op een deel van de naam
  const zoekKolom = (name: string): number => {
    const exact = headers.indexOf(name);
    if (exact >= 0) {
      return exact;
    }
    const lower = name.toLowerCase();
    for (let i = 0; i < headers.length; i++) {
      if (headers[i].toLowerCase().indexOf(lower) >= 0) {
        return i;
      }
    }
    return -1;
  };

  const idCol = col("Id");
  const winkelCol = col("Winkelnummer");
  const sapCol = col("SAP Winkelnr");
  const keuzeCol = col("Wel of Niet intekenen op de diverse zaden");

  const normalize = (value: string | number | boolean): string =>
    String(value ?? "").trim().toLowerCase();

  const parent: number[] = [];

  for (let i = 0; i < rows.length; i++) {
    parent.push(i);
  }

  function find(i: number): number {
    if (parent[i] !== i) {
      parent[i] = find(parent[i]);
    }
    return parent[i];
  }

  function union(a: number, b: number): void {
    const rootA = find(a);
    const rootB = find(b);

    if (rootA !== rootB) {
      parent[rootB] = rootA;
    }
  }

  const seenWinkel = new Map<string, number>();
  const seenSap = new Map<string, number>();

  for (let i = 0; i < rows.length; i++) {
    const winkel = normalize(rows[i][winkelCol]);
    const sap = normalize(rows[i][sapCol]);

    if (winkel !== "") {
      if (seenWinkel.has(winkel)) {
        union(i, seenWinkel.get(winkel)!);
      } else {
        seenWinkel.set(winkel, i);
      }
    }

    if (sap !== "") {
      if (seenSap.has(sap)) {
        union(i, seenSap.get(sap)!);
      } else {
        seenSap.set(sap, i);
      }
    }
  }

  const latest = new Map<number, number>();

  for (let i = 0; i < rows.length; i++) {
    const root = find(i);
    const previous = latest.get(root);

    if (
      previous === undefined ||
      Number(rows[i][idCol]) > Number(rows[previous][idCol])
    ) {
      latest.set(root, i);
    }
  }

  const result: (string | number | boolean)[][] = [];

  latest.forEach((index) => {
    if (normalize(rows[index][keuzeCol]) === "intekenen") {
      result.push(rows[index]);
    }
  });

  // Aantallen als getal opslaan, zodat ze opgeteld kunnen worden
  const totaalCols: number[] = [];
  const nietGevonden: string[] = [];

  for (let t = 0; t < TOTAAL_KOLOMMEN.length; t++) {
    const c = zoekKolom(TOTAAL_KOLOMMEN[t]);
    if (c >= 0) {
      totaalCols.push(c);
    } else {
      nietGevonden.push(TOTAAL_KOLOMMEN[t]);
    }
  }

  for (let r = 0; r < result.length; r++) {
    for (let t = 0; t < totaalCols.length; t++) {
      const c = totaalCols[t];
      const tekst = String(result[r][c] ?? "").trim().replace(",", ".");
      if (tekst !== "" && !isNaN(Number(tekst))) {
        result[r][c] = Number(tekst);
      }
    }
  }

  result.sort(
    (a, b) => Number(a[idCol]) - Number(b[idCol])
  );

  let sheet = workbook.getWorksheet(TARGET_SHEET);

  if (!sheet) {
    sheet = workbook.addWorksheet(TARGET_SHEET);
  }

  // Bestaande uitvoertabel verwijderen zonder Array.find().
  const tables = workbook.getTables();

  for (let i = 0; i < tables.length; i++) {
    if (tables[i].getName() === TARGET_TABLE) {
      tables[i].delete();
      break;
    }
  }

  // Blad leegmaken; de totalen in rij 1 worden hieronder opnieuw gezet.
  const used = sheet.getUsedRange();

  if (used) {
    used.clear(ExcelScript.ClearApplyTo.all);
  }

  const output: (string | number | boolean)[][] = [
    headers,
    ...result
  ];

  const range = sheet.getRangeByIndexes(
    START_ROW,
    0,
    output.length,
    headers.length
  );

  range.setValues(output);

  const table = sheet.addTable(range, true);
  table.setName(TARGET_TABLE);
  table.setPredefinedTableStyle("TableStyleMedium4");

  // Totalen boven de tabel (rij boven de kolomkoppen)
  if (START_ROW > 0 && totaalCols.length > 0) {
    const totaalRij = START_ROW - 1;

    // Label "Totaal" links van de eerste totaalkolom (of in kolom A)
    let eerste = totaalCols[0];
    for (let t = 1; t < totaalCols.length; t++) {
      eerste = Math.min(eerste, totaalCols[t]);
    }
    const labelCel = sheet.getRangeByIndexes(totaalRij, Math.max(eerste - 1, 0), 1, 1);
    if (eerste > 0) {
      labelCel.setValue("Totaal");
      labelCel.getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.right);
      labelCel.getFormat().getFont().setBold(true);
    }

    for (let t = 0; t < totaalCols.length; t++) {
      // In een tabelverwijzing moeten ' [ ] en # voorafgegaan worden door '
      const kolomNaam = headers[totaalCols[t]].replace(/(['\[\]#])/g, "'$1");
      const cel = sheet.getRangeByIndexes(totaalRij, totaalCols[t], 1, 1);
      cel.setFormula("=SUBTOTAL(109," + TARGET_TABLE + "[" + kolomNaam + "])");
      cel.getFormat().getFont().setBold(true);
      cel.getFormat().getFill().setColor("#DDEBF7");
      cel.getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);
    }
  }

  // Kolombreedte op de tabel afstemmen
  range.getFormat().autofitColumns();

  // Kolommen groeperen en dichtklappen (na het aanpassen van de breedte,
  // anders worden ze weer zichtbaar). Eerst een oude groepering opheffen,
  // zodat er geen dubbele niveaus ontstaan.
  if (GROEP_KOLOMMEN !== "") {
    const groep = sheet.getRange(GROEP_KOLOMMEN);
    try {
      groep.ungroup(ExcelScript.GroupOption.byColumns);
    } catch (e) {
      // Was nog niet gegroepeerd
    }
    groep.group(ExcelScript.GroupOption.byColumns);
    groep.hideGroupDetails(ExcelScript.GroupOption.byColumns);
  }

  let melding = result.length + " definitieve intekeningen bijgewerkt.";
  if (nietGevonden.length > 0) {
    melding += " Kolom niet gevonden voor totaal: " + nietGevonden.join(", ") + ".";
  }
  return melding;
}
